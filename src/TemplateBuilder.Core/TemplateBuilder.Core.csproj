<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Internal projects — DLLs bundled into lib via BundleInternalAssemblies below;
       PrivateAssets=all suppresses them from appearing as package dependencies. -->
  <ItemGroup>
    <ProjectReference Include="..\TemplateBuilder.Application\TemplateBuilder.Application.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\TemplateBuilder.Infrastructure\TemplateBuilder.Infrastructure.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- Runtime dependencies of the bundled assemblies — must be declared explicitly
       because PrivateAssets=all on ProjectReferences suppresses transitive packages. -->
  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.995" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Scriban" Version="7.2.6" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>TemplateBuilder.Core</PackageId>
    <Version>2.0.0</Version>
    <Authors>TemplateBuilder</Authors>
    <Description>Render TemplateBuilder templates to HTML strings. Call services.AddTemplateBuilder(...) then inject ITemplateEngine and call RenderAsync(templateId, model).</Description>
    <PackageTags>template;scriban;html;rendering</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/nagendra571/TemplateBuilder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/nagendra571/TemplateBuilder</PackageProjectUrl>
    <Copyright>Copyright © 2026 Nagendra Chinnam</Copyright>
  </PropertyGroup>

  <Target Name="BundleInternalAssemblies" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(OutputPath)TemplateBuilder.Domain.dll"
            Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
      <None Include="$(OutputPath)TemplateBuilder.Application.dll"
            Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
      <None Include="$(OutputPath)TemplateBuilder.Infrastructure.dll"
            Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
