@model TemplateBuilder.Web.ViewModels.TemplateEditorViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? $"Edit — {Model.Name}" : "New Template";
    var isNew = !Model.Id.HasValue;
}

<form id="editor-form" asp-action="@(isNew ? "Create" : "")" method="post">
    @Html.AntiForgeryToken()
    <div class="tb-editor-grid">

        <!-- LEFT: Field Palette -->
        <div class="tb-panel-left">
            <div class="tb-panel-heading" id="palette-heading">FIELD PALETTE</div>
            <div class="tb-view-selector-row">
                <label for="view-selector">SQL View</label>
                <select id="view-selector">
                    <option value="">— Select a view —</option>
                    @foreach (var v in Model.AvailableViews)
                    {
                        <option value="@v">@v</option>
                    }
                </select>
            </div>
            <div id="field-palette" aria-live="polite">
                <div class="tb-palette-msg">Select a view to see fields</div>
            </div>
            <div class="tb-blocks-section">
                <div class="tb-section-label">BLOCKS</div>
                <div class="tb-blocks-list">
                    <div class="palette-block" draggable="true" data-block="loop">Loop Block</div>
                    <div class="palette-block" draggable="true" data-block="grid">Grid Block</div>
                </div>
            </div>
        </div>

        <!-- CENTER: Canvas -->
        <div class="tb-panel-center">
            <div class="tb-panel-heading">CANVAS</div>
            <div class="tb-canvas-body">
                <textarea id="template-body" name="Body">@Model.Body</textarea>
            </div>
        </div>

        <!-- RIGHT: Properties -->
        <div class="tb-panel-right">
            <div class="tb-panel-heading">PROPERTIES</div>
            <div class="tb-props-body">
                <div>
                    <label for="prop-name">Template Name</label>
                    <input asp-for="Name" id="prop-name" />
                </div>
                <div>
                    <label for="prop-type">Type</label>
                    <select asp-for="TemplateType" id="prop-type">
                        <option value="Email">Email</option>
                        <option value="Report">Report</option>
                        <option value="Notice">Notice</option>
                        <option value="Custom">Custom</option>
                    </select>
                </div>
                <div>
                    <label for="prop-desc">Description</label>
                    <textarea asp-for="Description" id="prop-desc" rows="2"></textarea>
                </div>
                @if (!isNew)
                {
                    <div>
                        <label>Version</label>
                        <div class="tb-version-row">
                            <span id="version-display">v @Model.CurrentVersionNumber</span>
                            <button type="button" id="btn-history" class="btn btn-sm btn-secondary">History</button>
                        </div>
                    </div>
                    <div>
                        <label for="save-comment">Save Note (optional)</label>
                        <input type="text" id="save-comment" placeholder="What changed?" />
                    </div>
                }
            </div>
            <div class="tb-props-footer">
                <div id="save-error" class="tb-error-msg" role="alert" style="display:none;"></div>
                @if (!isNew)
                {
                    <button type="button" id="btn-preview" class="btn btn-secondary">Preview</button>
                    <button type="button" id="btn-save" class="btn btn-primary">Save Version</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary">Create Template</button>
                }
            </div>
        </div>
    </div>
</form>

<!-- Version History Modal -->
<div class="modal-overlay" id="version-modal" role="dialog" aria-modal="true" aria-labelledby="version-modal-title">
    <div class="modal modal--narrow">
        <div class="modal-header">
            <span id="version-modal-title" class="modal-title">Version History</span>
            <button class="modal-close" aria-label="Close">&#x2715;</button>
        </div>
        <div id="restore-error" class="tb-error-msg" role="alert" style="display:none;"></div>
        <div class="modal-body" id="version-history-content">Loading…</div>
    </div>
</div>

<!-- Preview Modal -->
<div class="modal-overlay" id="preview-modal" role="dialog" aria-modal="true" aria-labelledby="preview-modal-title">
    <div class="modal">
        <div class="modal-header">
            <span id="preview-modal-title" class="modal-title">Live Preview</span>
            <button class="modal-close" aria-label="Close">&#x2715;</button>
        </div>
        <div class="modal-body">
            <div class="tb-form-row">
                <label for="preview-json">Sample Data (JSON)</label>
                <textarea id="preview-json" class="tb-code-textarea" rows="6">{}</textarea>
            </div>
            <button class="btn btn-primary btn-sm" id="btn-render">Render</button>
            <div id="preview-error" class="tb-error-msg" role="alert" style="display:none;"></div>
            <div class="tb-preview-frame-wrap" id="preview-frame-wrap" style="display:none;">
                <iframe id="preview-frame" class="tb-preview-frame" title="Template preview"></iframe>
            </div>
        </div>
    </div>
</div>

@section Styles {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/suneditor@latest/dist/css/suneditor.min.css">
<link rel="stylesheet" href="~/css/template-editor.css" asp-append-version="true">
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/suneditor@latest/dist/suneditor.min.js"></script>
<script>
    const templateId = @(Model.Id?.ToString() ?? "null");
</script>
<script src="~/js/template-editor.js" asp-append-version="true"></script>
}
